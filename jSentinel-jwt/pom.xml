<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <parent>
    <groupId>com.svenruppert.jsentinel</groupId>
    <artifactId>jSentinel-parent</artifactId>
    <version>00.79.40</version>
  </parent>
  <modelVersion>4.0.0</modelVersion>

  <artifactId>jSentinel-jwt</artifactId>
  <name>jSentinel JWT — standardized JWT validation</name>
  <description>
    V00.76 opt-in module: Nimbus JOSE+JWT-backed default implementation of
    the jSentinel-core JWT SPIs (JwtValidator, JwksClient, JwtValidatorFactory)
    plus the JwtDiagnosticContributor. Framework-neutral — no Vaadin, no REST
    framework. The JOSE-free SPI contracts and result types live in
    jSentinel-core/jwt/api; this module is the only place a JOSE library is on
    the classpath. JWT/JWKS event types are published to jSentinel-events.
  </description>

  <properties>
    <nimbus-jose-jwt.version>10.3.1</nimbus-jose-jwt.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.svenruppert.jsentinel</groupId>
      <artifactId>jSentinel-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.svenruppert.jsentinel</groupId>
      <artifactId>jSentinel-events</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- V00.76: DiagnosticContributor SPI for JwtDiagnosticContributor (same
         module->dx pattern jSentinel-propagation already uses; dx does NOT
         depend on jSentinel-jwt, so this is acyclic and keeps dx Nimbus-free). -->
    <dependency>
      <groupId>com.svenruppert.jsentinel</groupId>
      <artifactId>jSentinel-dx</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.svenruppert.jsentinel</groupId>
      <artifactId>jSentinel-autoservice-annotations</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- V00.76: the only place a JOSE library is on the classpath (Konzept §5.2). -->
    <dependency>
      <groupId>com.nimbusds</groupId>
      <artifactId>nimbus-jose-jwt</artifactId>
      <version>${nimbus-jose-jwt.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- V00.76: @JSentinelAutoService -> META-INF/services for the
           JwtValidatorFactory + JwtDiagnosticContributor registrations. -->
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>com.svenruppert.jsentinel</groupId>
              <artifactId>jSentinel-autoservice-processor</artifactId>
              <version>${project.version}</version>
            </path>
            <path>
              <groupId>com.svenruppert.jsentinel</groupId>
              <artifactId>jSentinel-autoservice-annotations</artifactId>
              <version>${project.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <!--
        V00.76: ban Jackson / Gson / org.json on the compile/runtime classpath
        so no transitive JSON library can silently take over parsing. Nimbus
        brings its own minimal JSON; the framework JSON wire format stays the
        in-tree canonical codec. Test scope is allowed for cross-validation.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>ban-json-libraries</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>com.fasterxml.jackson.core:*</exclude>
                    <exclude>com.fasterxml.jackson.databind:*</exclude>
                    <exclude>com.google.code.gson:*</exclude>
                    <exclude>org.json:json</exclude>
                  </excludes>
                  <includes>
                    <include>com.fasterxml.jackson.core:*:*:*:test</include>
                    <include>com.fasterxml.jackson.databind:*:*:*:test</include>
                  </includes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
