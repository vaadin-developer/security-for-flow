<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <parent>
    <groupId>com.svenruppert.jsentinel</groupId>
    <artifactId>jSentinel-parent</artifactId>
    <version>00.79.00</version>
  </parent>
  <modelVersion>4.0.0</modelVersion>

  <artifactId>jSentinel-events-persistence-eclipsestore</artifactId>
  <name>jSentinel Events — Eclipse-Store persistence</name>
  <description>
    V00.75 Eclipse-Store-backed implementations of the four
    persistence SPIs in jSentinel-events (EventStore, DeadLetterStore,
    ReplayStore, SequenceStore) plus the optional Eclipse Serializer
    PayloadCodec. Shares the V00.74.20 JSentinelStoragePair lifecycle:
    consumers feed pair.app() into this module's stores so the
    Security-Event-Bus persistence rides the framework's two-phase
    shutdown.
  </description>

  <dependencies>
    <dependency>
      <groupId>com.svenruppert.jsentinel</groupId>
      <artifactId>jSentinel-events</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.svenruppert.jsentinel</groupId>
      <artifactId>jSentinel-persistence-eclipsestore</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>com.svenruppert.jsentinel</groupId>
      <artifactId>jSentinel-events-testkit</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
