<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <parent>
    <groupId>com.svenruppert.jsentinel</groupId>
    <artifactId>jSentinel-parent</artifactId>
    <version>00.80.00</version>
  </parent>
  <modelVersion>4.0.0</modelVersion>

  <artifactId>jSentinel-events-opentelemetry</artifactId>
  <name>jSentinel Events — OpenTelemetry exporter</name>
  <description>
    V00.80.00 (Konzept goal 8) EventBus integration: OpenTelemetryEventPublisher maps signed Security-Event envelopes to OpenTelemetry log records via the Logs Bridge API (opt-in, api-only at compile scope, noop-safe by construction).
  </description>

  <properties>
    <!-- Not managed by the parent BOM — this property is the single version home. -->
    <opentelemetry.version>1.62.0</opentelemetry.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.svenruppert.jsentinel</groupId>
      <artifactId>jSentinel-events</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-api</artifactId>
      <version>${opentelemetry.version}</version>
    </dependency>

    <!-- Tests run against a real in-memory SDK logger provider, no mocks. -->
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk-logs</artifactId>
      <version>${opentelemetry.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk-common</artifactId>
      <version>${opentelemetry.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.svenruppert.jsentinel</groupId>
      <artifactId>jSentinel-events-testkit</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
