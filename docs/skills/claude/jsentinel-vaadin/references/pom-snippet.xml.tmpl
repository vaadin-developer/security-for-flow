<!--
  jSentinel — Vaadin Flow integration.
  Merge these stanzas into your module's pom.xml. Do NOT overwrite the file.

  Required <properties>:
    <jsentinel.version>00.73.00</jsentinel.version>

  Required <dependencies>:
-->
<dependency>
    <groupId>com.svenruppert.jsentinel</groupId>
    <artifactId>jSentinel-core</artifactId>
    <version>${jsentinel.version}</version>
</dependency>
<dependency>
    <groupId>com.svenruppert.jsentinel</groupId>
    <artifactId>jSentinel-autoservice-annotations</artifactId>
    <version>${jsentinel.version}</version>
</dependency>
<dependency>
    <groupId>com.svenruppert.jsentinel</groupId>
    <artifactId>jSentinel-vaadin</artifactId>
    <version>${jsentinel.version}</version>
</dependency>
<dependency>
    <groupId>com.svenruppert.jsentinel</groupId>
    <artifactId>jSentinel-dx</artifactId>
    <version>${jsentinel.version}</version>
</dependency>
<dependency>
    <groupId>com.svenruppert.jsentinel</groupId>
    <artifactId>jSentinel-dx-vaadin</artifactId>
    <version>${jsentinel.version}</version>
</dependency>
<dependency>
    <groupId>com.svenruppert.jsentinel</groupId>
    <artifactId>jSentinel-vaadin-starter</artifactId>
    <version>${jsentinel.version}</version>
</dependency>
<!--
  Required transitively by jSentinel-vaadin's HttpSessionBindingListener
  reference; vaadin-core does not expose servlet-api compile-scope.
-->
<dependency>
    <groupId>jakarta.servlet</groupId>
    <artifactId>jakarta.servlet-api</artifactId>
    <version>6.1.0</version>
    <scope>provided</scope>
</dependency>

<!--
  Required <build><plugins><plugin>:
-->
<plugin>
    <artifactId>maven-compiler-plugin</artifactId>
    <configuration>
        <!--
          Path order matters on JDK 21+: *-processor BEFORE *-annotations.
          Reversed order causes silent no-emit of META-INF/services entries.
        -->
        <annotationProcessorPaths>
            <path>
                <groupId>com.svenruppert.jsentinel</groupId>
                <artifactId>jSentinel-autoservice-processor</artifactId>
                <version>${jsentinel.version}</version>
            </path>
            <path>
                <groupId>com.svenruppert.jsentinel</groupId>
                <artifactId>jSentinel-autoservice-annotations</artifactId>
                <version>${jsentinel.version}</version>
            </path>
        </annotationProcessorPaths>
    </configuration>
</plugin>
