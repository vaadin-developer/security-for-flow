package {{BASE_PACKAGE}}.views;

import eu.jsentinel.jcustos.oauth2.api.AuthorizationCodeFlow.AuthorizationRequest;
import eu.jsentinel.jcustos.oauth2.api.AuthorizationCodeFlow.StartRequestParams;
import com.vaadin.flow.component.UI;
import com.vaadin.flow.component.html.Div;
import com.vaadin.flow.router.BeforeEnterEvent;
import com.vaadin.flow.router.BeforeEnterObserver;
import com.vaadin.flow.router.Route;

import {{BASE_PACKAGE}}.security.oidc.OidcClients;
import {{BASE_PACKAGE}}.security.oidc.OidcNonceStore;

import java.security.SecureRandom;
import java.util.Base64;
import java.util.Map;
import java.util.Optional;
import java.util.Set;

/**
 * Starts OIDC federated login: generates a nonce, asks the authorization-code flow for
 * the redirect to the IdP (PKCE verifier + state are stored in the Vaadin-session
 * {@code StateStore}), keeps the nonce keyed by the state, then redirects the browser.
 * Replaces the local username/password {@code MyLoginView}.
 */
@Route("login")
public class OidcLoginView extends Div implements BeforeEnterObserver {

  private static final SecureRandom RNG = new SecureRandom();

  @Override
  public void beforeEnter(BeforeEnterEvent event) {
    String nonce = randomUrlSafe();
    AuthorizationRequest request = OidcClients.get().flow().startRequest(
        new StartRequestParams(Set.of(), Map.of(), Optional.of(nonce), Optional.empty()));
    OidcNonceStore.put(request.stateKey(), nonce);
    UI.getCurrent().getPage().setLocation(request.redirectTo().toString());
  }

  private static String randomUrlSafe() {
    byte[] bytes = new byte[32];
    RNG.nextBytes(bytes);
    return Base64.getUrlEncoder().withoutPadding().encodeToString(bytes);
  }
}
