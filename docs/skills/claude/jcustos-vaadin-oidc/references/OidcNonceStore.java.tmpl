package {{BASE_PACKAGE}}.security.oidc;

import com.vaadin.flow.server.VaadinSession;

import java.util.HashMap;
import java.util.Map;

/**
 * Threads the OIDC {@code nonce} from login ({@code startRequest}) to callback
 * (ID-token validation), keyed by the flow's {@code stateKey}, in the Vaadin session.
 *
 * <p>Necessary because {@code AuthorizationCodeFlow.handleCallback(...)} consumes the
 * framework {@code StateStore} single-use and returns only the {@code TokenResponse} —
 * the bound nonce is gone afterwards. Without keeping our own copy, the ID-token
 * {@code nonce} check (ID-token replay protection) cannot run.
 */
public final class OidcNonceStore {

  private static final String ATTR = OidcNonceStore.class.getName();

  private OidcNonceStore() {
  }

  @SuppressWarnings("unchecked")
  private static Map<String, String> map() {
    VaadinSession session = VaadinSession.getCurrent();
    Map<String, String> m = (Map<String, String>) session.getAttribute(ATTR);
    if (m == null) {
      m = new HashMap<>();
      session.setAttribute(ATTR, m);
    }
    return m;
  }

  public static void put(String stateKey, String nonce) {
    map().put(stateKey, nonce);
  }

  /** Single-use: returns + removes the nonce bound to {@code stateKey}, or {@code null}. */
  public static String consume(String stateKey) {
    return map().remove(stateKey);
  }
}
