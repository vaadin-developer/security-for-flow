<!--
  jSentinel — REST integration (JDK HttpServer based).
  Merge these stanzas into your module's pom.xml.

  Required <properties>:
    <jsentinel.version>00.73.00</jsentinel.version>

  Required <dependencies>:
-->
<dependency>
    <groupId>com.svenruppert.jsentinel</groupId>
    <artifactId>jSentinel-core</artifactId>
    <version>${jsentinel.version}</version>
</dependency>
<dependency>
    <groupId>com.svenruppert.jsentinel</groupId>
    <artifactId>jSentinel-autoservice-annotations</artifactId>
    <version>${jsentinel.version}</version>
</dependency>
<dependency>
    <groupId>com.svenruppert.jsentinel</groupId>
    <artifactId>jSentinel-rest</artifactId>
    <version>${jsentinel.version}</version>
</dependency>
<dependency>
    <groupId>com.svenruppert.jsentinel</groupId>
    <artifactId>jSentinel-dx</artifactId>
    <version>${jsentinel.version}</version>
</dependency>
<dependency>
    <groupId>com.svenruppert.jsentinel</groupId>
    <artifactId>jSentinel-dx-rest</artifactId>
    <version>${jsentinel.version}</version>
</dependency>
<dependency>
    <groupId>jakarta.servlet</groupId>
    <artifactId>jakarta.servlet-api</artifactId>
    <version>6.1.0</version>
    <scope>provided</scope>
</dependency>

<!--
  Required <build><plugins><plugin>:
-->
<plugin>
    <artifactId>maven-compiler-plugin</artifactId>
    <configuration>
        <annotationProcessorPaths>
            <path>
                <groupId>com.svenruppert.jsentinel</groupId>
                <artifactId>jSentinel-autoservice-processor</artifactId>
                <version>${jsentinel.version}</version>
            </path>
            <path>
                <groupId>com.svenruppert.jsentinel</groupId>
                <artifactId>jSentinel-autoservice-annotations</artifactId>
                <version>${jsentinel.version}</version>
            </path>
        </annotationProcessorPaths>
    </configuration>
</plugin>
