package {{BASE_PACKAGE}}.security.oidc;

import com.nimbusds.jose.jwk.JWK;
import com.nimbusds.jose.jwk.gen.ECKeyGenerator;
import com.nimbusds.jose.jwk.Curve;
import eu.jsentinel.jcustos.dpop.DpopProofGenerator;

import java.net.URI;
import java.net.http.HttpClient;
import java.net.http.HttpRequest;
import java.net.http.HttpResponse;
import java.util.Optional;

/**
 * Calls a resource server with a DPoP-bound access token (RFC 9449): attaches the
 * {@code Authorization: DPoP <token>} header plus a fresh {@code DPoP} proof header
 * signed with the client's key, so a stolen access token is useless without the key.
 *
 * <p>NOTE: the access token must itself be DPoP-bound ({@code cnf.jkt}) by the OP, which
 * requires sending a DPoP proof to the <em>token endpoint</em> — the stable token-endpoint
 * client does not do that yet (framework gap). This helper is for <em>presenting</em> DPoP
 * at a resource server you control.
 */
public final class DpopResourceClient {

  private final HttpClient http;
  private final JWK dpopKey;
  private final DpopProofGenerator generator = new DpopProofGenerator();

  public DpopResourceClient(HttpClient http, JWK dpopKey) {
    if (!dpopKey.isPrivate()) {
      throw new IllegalArgumentException("the DPoP key must contain its private half");
    }
    this.http = http;
    this.dpopKey = dpopKey;
  }

  /** Generates a per-client DPoP signing key (EC P-256). Persist + reuse it per resource origin. */
  public static JWK newKey() {
    try {
      return new ECKeyGenerator(Curve.P_256).generate();
    } catch (Exception e) {
      throw new IllegalStateException("failed to generate a DPoP key", e);
    }
  }

  public HttpResponse<String> get(URI uri, String accessToken) throws Exception {
    return send("GET", uri, accessToken);
  }

  public HttpResponse<String> send(String method, URI uri, String accessToken) throws Exception {
    String proof = generator.generate(dpopKey, method, uri, Optional.of(accessToken));
    HttpRequest request = HttpRequest.newBuilder(uri)
        .header("Authorization", "DPoP " + accessToken)
        .header("DPoP", proof)
        .method(method, HttpRequest.BodyPublishers.noBody())
        .build();
    return http.send(request, HttpResponse.BodyHandlers.ofString());
  }
}
