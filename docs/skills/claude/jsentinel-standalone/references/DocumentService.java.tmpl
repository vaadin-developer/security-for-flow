package {{BASE_PACKAGE}}.services;

import com.svenruppert.jsentinel.authorization.annotations.RequiresPermission;

import java.util.List;

/**
 * Application surface that the CLI commands call. Each method
 * carries a {@link RequiresPermission @RequiresPermission} — the
 * {@code SecuredProxy.wrap(DocumentService.class, impl)} layer
 * enforces it before the call reaches the implementation.
 *
 * <p>Subjects without the permission see an {@code AccessDeniedException}
 * which the CLI loop in {@code Main} catches and turns into a
 * "DENIED — …" message.
 */
public interface DocumentService {

  @RequiresPermission("doc:list")
  List<String> list();

  @RequiresPermission("doc:create")
  void create(String title);

  @RequiresPermission("doc:delete")
  void delete(String title);
}
