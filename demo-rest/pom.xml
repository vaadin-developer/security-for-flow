<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <parent>
    <groupId>com.svenruppert</groupId>
    <artifactId>security-for-flow-parent</artifactId>
    <version>00.51.00</version>
  </parent>
  <modelVersion>4.0.0</modelVersion>

  <artifactId>demo-rest</artifactId>
  <name>Security for Vaadin - REST Demo</name>
  <description>Demo application for REST security, permissions, protected handlers, and HTTP status mapping.</description>

  <properties>
    <!--
      demo-rest is consumed as a test-scope dependency by
      demo-vaadin-rest-client (HttpDemoBackendClientTest spins up an
      in-process DemoRestServer). It must therefore land in the local
      ~/.m2 — install must NOT be skipped. Remote deploy stays off.
    -->
    <maven.deploy.skip>true</maven.deploy.skip>
    <gpg.skip>true</gpg.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.svenruppert</groupId>
      <artifactId>security-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.svenruppert</groupId>
      <artifactId>security-rest</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.svenruppert</groupId>
      <artifactId>demo-rest-shared</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- deploy is suppressed via the maven.deploy.skip property above. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-deploy-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>first</id>
            <phase>none</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <mainClass>com.svenruppert.vaadin.security.demo.rest.server.DemoRestServer</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>