<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <parent>
    <groupId>com.svenruppert.jsentinel</groupId>
    <artifactId>jSentinel-parent</artifactId>
    <version>00.74.00-SNAPSHOT</version>
  </parent>
  <modelVersion>4.0.0</modelVersion>

  <artifactId>demo-standalone</artifactId>
  <name>jSentinel - Standalone Demo</name>
  <description>Demo CLI application showing how a plain Java program consumes the standalone security adapter.</description>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <gpg.skip>true</gpg.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.svenruppert.jsentinel</groupId>
      <artifactId>jSentinel-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.svenruppert.jsentinel</groupId>
      <artifactId>jSentinel-standalone</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!--
      Annotations module shipped by jSentinel-processor's underlying
      proxybuilder. The processor emits @GeneratedByProxyBuilder into
      every wrapper class; consumers of the processor need the
      annotation type on their compile classpath even though
      RetentionPolicy.RUNTIME makes it stay around at runtime too
      (and reflectable: tooling can detect generated wrappers).
    -->
    <dependency>
      <groupId>com.svenruppert</groupId>
      <artifactId>proxybuilder-annotations</artifactId>
      <version>00.11.00</version>
    </dependency>
    <!--
      V00.72: @JSentinelAutoService replaces the manual META-INF/services
      files for DemoAuthenticationService and DemoAuthorizationService.
      The processor is wired under annotationProcessorPaths below.
    -->
    <dependency>
      <groupId>com.svenruppert.jsentinel</groupId>
      <artifactId>jSentinel-autoservice-annotations</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!--
      V00.72 fluent bootstrap. DemoApp.main() calls
      StandaloneSecurity.bootstrap() to wire services into
      JSentinelServiceResolver and print the resulting JSentinelRuntime
      diagnostics line at startup.
    -->
    <dependency>
      <groupId>com.svenruppert.jsentinel</groupId>
      <artifactId>jSentinel-dx</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.svenruppert.jsentinel</groupId>
      <artifactId>jSentinel-dx-standalone</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.svenruppert.jsentinel</groupId>
      <artifactId>jSentinel-test</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!--
            Wire jSentinel-processor as a compile-time annotation
            processor. The processor expands @Secured-annotated classes
            into a <Type>Secured subclass that routes every guarded
            method through JSentinelEnforcer before the super-call.
          -->
          <annotationProcessorPaths>
            <path>
              <groupId>com.svenruppert.jsentinel</groupId>
              <artifactId>jSentinel-processor</artifactId>
              <version>${project.version}</version>
            </path>
            <path>
              <groupId>com.svenruppert.jsentinel</groupId>
              <artifactId>jSentinel-autoservice-processor</artifactId>
              <version>${project.version}</version>
            </path>
            <!-- Processor reads the @JSentinelAutoService annotation class
                 reflectively; make sure it is on the processor path too. -->
            <path>
              <groupId>com.svenruppert.jsentinel</groupId>
              <artifactId>jSentinel-autoservice-annotations</artifactId>
              <version>${project.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>first</id>
            <phase>none</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>