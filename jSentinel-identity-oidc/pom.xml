<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <parent>
    <groupId>com.svenruppert.jsentinel</groupId>
    <artifactId>jSentinel-parent</artifactId>
    <version>00.79.30-SNAPSHOT</version>
  </parent>
  <modelVersion>4.0.0</modelVersion>

  <artifactId>jSentinel-identity-oidc</artifactId>
  <name>jSentinel OIDC — Relying-Party identity layer</name>
  <description>
    V00.78 opt-in module: OpenID Connect Relying-Party identity on top of the
    V00.76 JWT and V00.77 OAuth2 building blocks — discovery, ID-token validation
    (nonce / azp / at_hash / auth_time / acr), UserInfo, RP-initiated logout and
    claims-to-subject mapping. JDK HttpClient only; the in-tree JSON scanner parses
    responses (no JSON library). ID-token validation composes the jSentinel-jwt
    JwtValidator SPI. Framework-neutral — no Vaadin / REST adapter types.
  </description>

  <dependencies>
    <dependency>
      <groupId>com.svenruppert.jsentinel</groupId>
      <artifactId>jSentinel-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- V00.78: ID-token validation composes the JwtValidator SPI (V00.76). -->
    <dependency>
      <groupId>com.svenruppert.jsentinel</groupId>
      <artifactId>jSentinel-jwt</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- V00.78: consumes the OAuth2 auth-code flow / token endpoint (V00.77). -->
    <dependency>
      <groupId>com.svenruppert.jsentinel</groupId>
      <artifactId>jSentinel-oauth2</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.svenruppert.jsentinel</groupId>
      <artifactId>jSentinel-events</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- V00.78: DiagnosticContributor SPI (same module->dx pattern as jSentinel-oauth2). -->
    <dependency>
      <groupId>com.svenruppert.jsentinel</groupId>
      <artifactId>jSentinel-dx</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.svenruppert.jsentinel</groupId>
      <artifactId>jSentinel-autoservice-annotations</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- V00.78: @JSentinelAutoService -> META-INF/services registrations. -->
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>com.svenruppert.jsentinel</groupId>
              <artifactId>jSentinel-autoservice-processor</artifactId>
              <version>${project.version}</version>
            </path>
            <path>
              <groupId>com.svenruppert.jsentinel</groupId>
              <artifactId>jSentinel-autoservice-annotations</artifactId>
              <version>${project.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <!--
        V00.78: ban Jackson / Gson / org.json. Discovery / UserInfo / ID-token
        responses are parsed by the in-tree depth-aware JSON scanner; no transitive
        JSON library may take over. (Nimbus JOSE arrives via jSentinel-jwt for
        signature validation and is intentionally allowed — not a JSON-wire library.)
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>ban-json-libraries</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>com.fasterxml.jackson.core:jackson-databind</exclude>
                    <exclude>com.google.code.gson:*</exclude>
                    <exclude>org.json:json</exclude>
                  </excludes>
                  <includes>
                    <include>com.fasterxml.jackson.core:*:*:*:test</include>
                  </includes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
