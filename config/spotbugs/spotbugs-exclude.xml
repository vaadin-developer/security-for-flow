<?xml version="1.0" encoding="UTF-8"?>
<!--
  V00.75.10 H3 — SpotBugs / FindSecBugs baseline exclude (Konzept §5.3).
  Findings present when the gate was introduced are excluded so it starts green
  and only NEW findings break the build. Each entry is a documented backlog item.

  Categories:
   - EI_EXPOSE_REP / EI_EXPOSE_REP2: value records / carriers returning or
     storing component arrays/collections by design (immutable value objects).
   - UNSAFE_HASH_EQUALS: FindSecBugs flags String#equals on hash-looking values;
     the constant-time paths use MessageDigest.isEqual, the flagged ones are
     store lookups. Backlog.
   - BC_VACUOUS_INSTANCEOF: the static resolver's default-instance fallback.
   - HARD_CODE_PASSWORD: the dummy (timing-equalising) verification service.
   - DCN_NULLPOINTER_EXCEPTION / DMI_RANDOM_USED_ONLY_ONCE /
     SING_SINGLETON_HAS_NONPRIVATE_CONSTRUCTOR: localised, low-risk. Backlog.
-->
<FindBugsFilter>
  <Match><Bug pattern="EI_EXPOSE_REP"/></Match>
  <Match><Bug pattern="EI_EXPOSE_REP2"/></Match>
  <Match><Bug pattern="UNSAFE_HASH_EQUALS"/></Match>
  <Match><Bug pattern="BC_VACUOUS_INSTANCEOF"/></Match>
  <Match><Bug pattern="DCN_NULLPOINTER_EXCEPTION"/></Match>
  <Match>
    <Class name="com.svenruppert.jsentinel.credential.password.dummy.DefaultDummyVerificationService"/>
    <Bug pattern="HARD_CODE_PASSWORD"/>
  </Match>
  <Match>
    <Class name="com.svenruppert.jsentinel.credential.password.pepper.PepperApplicator"/>
    <Bug pattern="DMI_RANDOM_USED_ONLY_ONCE"/>
  </Match>
  <Match>
    <Class name="com.svenruppert.jsentinel.session.NoopSessionPolicy"/>
    <Bug pattern="SING_SINGLETON_HAS_NONPRIVATE_CONSTRUCTOR"/>
  </Match>
  <Match>
    <Class name="com.svenruppert.jsentinel.rest.RestJSentinelVersionFilter"/>
    <Bug pattern="NP_NULL_PARAM_DEREF"/>
  </Match>
  <!--
    V00.75.20 RF-01 (exit review): MS_EXPOSE_REP on
    JSentinelServiceResolver.current(). Returning the shared process-wide
    DEFAULT JSentinelContext is the intended static-facade accessor (V00.75.10
    H5), documented as the deliberate process-global surface in R038 — not an
    accidental leak. Latent since H5; surfaced by the exit-review gate (the
    baseline excludes the instance EI_EXPOSE_REP* but not the static
    MS_EXPOSE_REP). Scoped to this one method so the rule stays strict elsewhere.
  -->
  <Match>
    <Class name="com.svenruppert.jsentinel.authorization.api.JSentinelServiceResolver"/>
    <Method name="current"/>
    <Bug pattern="MS_EXPOSE_REP"/>
  </Match>

  <!--
    V00.76.10 H2 — reactor-wide SpotBugs rollout (the gate moved from 5 modules
    into jSentinel-parent, so 20 more modules now run it). Three justified
    excludes surfaced by that rollout:

    1) SE_BAD_FIELD on the Vaadin adapter classes. These are Serializable ONLY
       because Vaadin's UI/navigation lifecycle requires it (a documented
       legitimate Serializable shape — see docs/security/credentials/standards/
       serialization-policy.md). The flagged fields are stateless strategy
       singletons resolved via JSentinelServiceResolver/ServiceLoader, not state.
       Marking them `transient final` would null them after session
       deserialization (final cannot be re-assigned without readObject
       machinery); the project does NOT use Java session serialization (Eclipse-
       Store / JSON per the policy), so the array/field is never actually
       serialized. Scoped to the four concrete classes so the rule stays strict.
  -->
  <Match>
    <Or>
      <Class name="com.svenruppert.jsentinel.authorization.impl.AuthorizationListener"/>
      <Class name="com.svenruppert.jsentinel.components.SecuredButton"/>
      <Class name="com.svenruppert.jsentinel.components.SecuredRouterLink"/>
      <Class name="com.svenruppert.jsentinel.session.vaadin.JSentinelVersionEnforcerListener"/>
    </Or>
    <Bug pattern="SE_BAD_FIELD"/>
  </Match>

  <!--
    2) WEAK_MESSAGE_DIGEST_SHA1 on the HIBP checker. The Have-I-Been-Pwned
       range API is defined on SHA-1 k-anonymity: the client MUST hash the
       candidate password with SHA-1 and send the first five hex chars of the
       digest. SHA-1 here is a wire-protocol requirement of a third-party API,
       NOT password storage or a security primitive we choose — the password
       pipeline hashes with Argon2id/PBKDF2 elsewhere. Cannot be "fixed" without
       breaking the HIBP contract. Scoped to the single (single-purpose) class.
  -->
  <Match>
    <Class name="com.svenruppert.jsentinel.credential.compromised.hibp.HaveIBeenPwnedCompromisedPasswordChecker"/>
    <Bug pattern="WEAK_MESSAGE_DIGEST_SHA1"/>
  </Match>

  <!--
    3) POTENTIAL_XML_INJECTION on the propagation annotation processor. The
       generator emits Java source at COMPILE time from compile-time-known
       method identifiers and parameter names (never runtime/attacker input);
       Java identifiers cannot contain the quote/markup chars the detector
       fears. It is a build-time code generator, not a request path. V00.76.10
       R17/R18 hardened the generator (compile-time type-parameter rendering,
       Types.erasure for the reflective .class literals, inline try/catch instead
       of a fragile String.replace) — but the StringBuilder-builds-source pattern
       remains, so the detector still fires. The values emitted as literals are
       provably safe identifiers, so this is a permanent justified exclude.
       Scoped to the processor class.
  -->
  <Match>
    <Class name="~com\.svenruppert\.jsentinel\.propagation\.processor\.PropagateTokenProcessor.*"/>
    <Bug pattern="POTENTIAL_XML_INJECTION"/>
  </Match>

  <!--
    V00.79.10 (exit-review): MS_EXPOSE_REP on the two demo-vaadin static
    test-seam providers. Both return a deliberately swappable static instance
    so tests can replace the backing SPI before exercising it (the Javadoc on
    each documents the setter + reset()). This is the same intended-static-
    accessor pattern already excluded for JSentinelServiceResolver.current()
    (V00.75.20 RF-01) — not an accidental leak, and confined to demo modules
    that are never part of the Central bundle. Scoped to the two accessor
    methods so the rule stays strict elsewhere. (Pre-existing since the V00.73
    rebrand; surfaced when the demo reactor was rebuilt under -Pstatic-analysis.)
  -->
  <Match>
    <Class name="com.svenruppert.jsentinel.demo.app.security.model.DemoUserDirectoryProvider"/>
    <Method name="directory"/>
    <Bug pattern="MS_EXPOSE_REP"/>
  </Match>
  <Match>
    <Class name="com.svenruppert.jsentinel.demo.app.security.services.DemoSessionStoreProvider"/>
    <Method name="sessionStore"/>
    <Bug pattern="MS_EXPOSE_REP"/>
  </Match>
</FindBugsFilter>
